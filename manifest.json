{
  "manifest_version": 3,
  "name": "Mino — Minimal New Tab",
  "version": "1.2.3",
  "description": "A calm, personal new tab with todos, calendar, shortcuts, and private workspace sync.",
  "homepage_url": "https://minotab.site",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["storage", "identity", "search"],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
