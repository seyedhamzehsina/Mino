{
  "manifest_version": 3,
  "name": "Mino",
  "version": "1.1.0",
  "description": "Everything essential. Nothing extra.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://*.supabase.co/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
